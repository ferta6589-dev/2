ASSETS=BTC
PROFIT_BPS_MIN=50
MIN_TIME_TO_SETTLE_S=10
FEE_RATE_BPS=200
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HTTP_HOST=https://clob.polymarket.com
CLOB_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/market
LOG_DIR=./logs
DISCOVERY_INTERVAL_S=15

# --- Weather strategy (METAR-driven, paper-only by default) ---
WEATHER_ENABLED=false
# Comma-separated cities, or empty to auto-discover all weather events on Polymarket.
WEATHER_CITIES=
WEATHER_DISCOVERY_INTERVAL_S=600
WEATHER_MAX_OPEN_EVENTS=8
WEATHER_PER_EVENT_BUDGET_USD=30.0
WEATHER_MAX_PRICE=0.40
WEATHER_LOG_FILENAME_PREFIX=weather_trades

# Adaptive METAR poll cadence (NOAA tgftp).
# Fast period applies inside the publish window (HH:25-40, HH:55-10 UTC).
WEATHER_METAR_FAST_PERIOD_S=20
WEATHER_METAR_SLOW_PERIOD_S=180
# Use Ogimet as a fallback (rate-limit-friendly: ≤1 req/min recommended).
WEATHER_OGIMET_FALLBACK=false

# Live execution is a stub (raises NotImplementedError). v2 will wire py-clob-client.
WEATHER_LIVE_ENABLED=false
# POLYGON_PRIVATE_KEY=
# POLYGON_PROXY_ADDRESS=
