ASSETS=BTC
PROFIT_BPS_MIN=50
MIN_TIME_TO_SETTLE_S=10
FEE_RATE_BPS=200
GAMMA_HOST=https://gamma-api.polymarket.com
CLOB_HTTP_HOST=https://clob.polymarket.com
CLOB_WS_HOST=wss://ws-subscriptions-clob.polymarket.com/ws/market
LOG_DIR=./logs
DISCOVERY_INTERVAL_S=15

# --- Weather strategy (paper-only by default) ---
WEATHER_ENABLED=false
# Comma-separated city codes, or empty to auto-discover all weather events on Polymarket.
WEATHER_CITIES=
WEATHER_LOOKAHEAD_DAYS=7
WEATHER_DISCOVERY_INTERVAL_S=600
NWS_HOST=https://api.weather.gov
NWS_USER_AGENT=polyarb (contact@example.com)
NWS_POLL_INTERVAL_S=1800
OPEN_METEO_HOST=https://api.open-meteo.com
OPEN_METEO_ENABLED=true
WEATHER_PER_EVENT_BUDGET_USD=30.0
WEATHER_MAX_OPEN_EVENTS=8
WEATHER_CENTRAL_MAX_PRICE=0.40
WEATHER_WING_MAX_PRICE=0.20
WEATHER_MIN_WINDOW_PROB=0.55
WEATHER_LOG_FILENAME_PREFIX=weather_trades

# Live execution is a stub (raises NotImplementedError). v2 will wire py-clob-client.
WEATHER_LIVE_ENABLED=false
